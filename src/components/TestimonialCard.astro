---
interface Props {
  quote: string;
  name: string;
  role: string;
  image: string;
}

const { quote, name, role, image } = Astro.props;
---

<div class="testimonial-card card">
  <div class="testimonial-card__image-wrap">
    <img src={image} alt={name} class="card__image" />
  </div>
  <div class="card__body">
    <div class="testimonial-card__cap">
      <h5 class="capfont">{name}</h5>
      <p class="card__meta">{role}</p>
    </div>
    <blockquote class="testimonial-card__quote">&ldquo;{quote}&rdquo;</blockquote>
  </div>
</div>

<style>
  .testimonial-card__image-wrap {
    position: relative;
    overflow: hidden;
  }
  .testimonial-card__image-wrap::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: #50fbed;
    mix-blend-mode: multiply;
    z-index: 1;
    opacity: 0.5;
  }
  .testimonial-card__image-wrap::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: #550291;
    mix-blend-mode: screen;
    z-index: 2;
    opacity: 0.5;
  }
  .testimonial-card__cap h5 {
    font-size: 0.95rem;
    margin-bottom: 2px;
  }
  .testimonial-card__quote {
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0;
    line-height: 1.6;
    border: none;
    padding: 0;
  }
</style>
