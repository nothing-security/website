---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Home">
  <!-- Hero Section - left aligned text, full-width bg -->
  <section class="hero">
    <img src="/images/header-home01-header.jpg" alt="" class="hero__bg" />
    <div class="hero__overlay"></div>
    <div class="hero__particles">
      <hr style="left:50%;top:13%;width:8px;height:8px;" /><hr style="left:55%;top:1%;width:10px;height:6px;" />
      <hr style="left:55%;top:37%;width:10px;height:8px;" /><hr style="left:76%;top:75%;width:9px;height:7px;" />
      <hr style="left:31%;top:35%;width:6px;height:9px;" /><hr style="left:3%;top:44%;width:9px;height:6px;" />
      <hr style="left:36%;top:45%;width:7px;height:10px;" /><hr style="left:5%;top:81%;width:8px;height:7px;" />
    </div>
    <div class="hero__content container">
      <div class="hero__grid">
        <div class="hero__text">
          <i class="hero__decor"></i>
          <h2 class="hero__title glitch-text" data-text="Total Security Oversight">Total Security Oversight</h2>
          <h4 class="hero__subtitle">If you're using any of the three major cloud providers, you already have Nothing Security built-in.</h4>
          <h4 class="hero__subtitle">You don't have to lift a finger to Do Nothing&trade;</h4>
          <a href="#roi-section" class="btn btn--primary btn--large">Discover Nothing</a>
        </div>
        <div></div>
      </div>
    </div>
  </section>

  <!-- ROI Charts Section -->
  <section class="section section--paper" id="roi-section">
    <div class="container">
      <div class="section-caption">
        <h6 class="section-caption__label"><span>The Numbers Don't Lie</span></h6>
        <h2 class="section-caption__title glitch-text" data-text="RETURN ON DOING NOTHING">RETURN ON DOING NOTHING</h2>
        <p class="section-caption__desc">See what happens when you stop paying for security theater</p>
      </div>
      <div class="grid grid--2">
        <div class="chart-card">
          <h4>Security Spending vs. Cybercrime Losses</h4>
          <div class="bar-chart">
            <div class="bar-chart__row">
              <span class="bar-chart__label">2018</span>
              <div class="bar-chart__bars">
                <div class="bar-chart__bar bar-chart__bar--spend" style="width: 18%;">$96B</div>
                <div class="bar-chart__bar bar-chart__bar--loss" style="width: 9%;">$45B</div>
              </div>
              <span class="bar-chart__ratio">2:1</span>
            </div>
            <div class="bar-chart__row">
              <span class="bar-chart__label">2022</span>
              <div class="bar-chart__bars">
                <div class="bar-chart__bar bar-chart__bar--spend" style="width: 30%;">$150B</div>
                <div class="bar-chart__bar bar-chart__bar--loss" style="width: 55%;">$6T</div>
              </div>
              <span class="bar-chart__ratio">1:40</span>
            </div>
            <div class="bar-chart__row">
              <span class="bar-chart__label">2025</span>
              <div class="bar-chart__bars">
                <div class="bar-chart__bar bar-chart__bar--spend" style="width: 40%;">$213B</div>
                <div class="bar-chart__bar bar-chart__bar--loss" style="width: 100%;">$10.5T</div>
              </div>
              <span class="bar-chart__ratio">1:50</span>
            </div>
          </div>
          <div class="chart-legend">
            <span class="chart-legend__item"><span class="chart-legend__color chart-legend__color--spend"></span>Security Spending</span>
            <span class="chart-legend__item"><span class="chart-legend__color chart-legend__color--loss"></span>Cybercrime Losses</span>
          </div>
          <p class="chart-source">Sources: <a href="https://www.gartner.com/en/newsroom/press-releases/2025-07-29-gartner-forecasts-worldwide-end-user-spending-on-information-security-to-total-213-billion-us-dollars-in-2025" target="_blank">Gartner</a>, <a href="https://cybersecurityventures.com/cybercrime-damage-costs-10-trillion-by-2025/" target="_blank">Cybersecurity Ventures</a></p>
        </div>
        <div class="chart-card">
          <h4>Where Your Security Budget Actually Goes</h4>
          <div class="waste-chart">
            <div class="waste-chart__item">
              <div class="waste-chart__bar-bg">
                <div class="waste-chart__bar-fill" style="width: 53%;">53%</div>
              </div>
              <span class="waste-chart__label">SIEM alerts that are false positives</span>
            </div>
            <div class="waste-chart__item">
              <div class="waste-chart__bar-bg">
                <div class="waste-chart__bar-fill" style="width: 50%;">50%</div>
              </div>
              <span class="waste-chart__label">Orgs that say their DLP is ineffective</span>
            </div>
            <div class="waste-chart__item">
              <div class="waste-chart__bar-bg">
                <div class="waste-chart__bar-fill waste-chart__bar-fill--red" style="width: 82%;">82%</div>
              </div>
              <span class="waste-chart__label">Detections that are malware-free (EDR miss)</span>
            </div>
            <div class="waste-chart__item">
              <div class="waste-chart__bar-bg">
                <div class="waste-chart__bar-fill waste-chart__bar-fill--red" style="width: 60%;">60%</div>
              </div>
              <span class="waste-chart__label">Breaches from known, unpatched vulns</span>
            </div>
            <div class="waste-chart__item">
              <div class="waste-chart__bar-bg">
                <div class="waste-chart__bar-fill" style="width: 30%;">30%</div>
              </div>
              <span class="waste-chart__label">Security alerts that go uninvestigated</span>
            </div>
          </div>
          <p class="chart-source">Sources: <a href="https://www.verizon.com/business/resources/reports/dbir/" target="_blank">Verizon DBIR 2025</a>, <a href="https://www.vectra.ai/topics/edr-evasion" target="_blank">CrowdStrike/Vectra</a></p>
        </div>
      </div>

      <div class="spacer-m"></div>

      <div class="roi-callout">
        <div class="roi-callout__inner">
          <h3>Nothing Security ROI Calculator</h3>
          <div class="roi-callout__grid">
            <div class="roi-callout__stat">
              <var>$0</var>
              <span>Annual Cost of Nothing</span>
            </div>
            <div class="roi-callout__stat">
              <var>76</var>
              <span>Security Tools You Can Eliminate</span>
            </div>
            <div class="roi-callout__stat">
              <var>$1,070</var>
              <span>Saved Per Employee Per Year</span>
            </div>
            <div class="roi-callout__stat">
              <var>100%</var>
              <span>Reduction in False Positives</span>
            </div>
          </div>
          <p class="roi-callout__note">The average enterprise runs 76 security tools. Companies with 50+ tools are <strong>8% worse</strong> at detecting threats. <a href="https://www.isaca.org/resources/news-and-trends/isaca-now-blog/2025/tool-sprawl-why-more-cyber-tools-make-you-less-secure" target="_blank">More tools = less security.</a></p>
          <div class="spacer-s"></div>
          <a href="/industry-outlook-2026/" class="btn btn--ghost">Download 2026 Industry Outlook</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 720° Protection - Service Cards -->
  <section class="section animate-on-scroll" id="section-cards">
    <div class="container">
      <div class="section-caption">
        <h6 class="section-caption__label"><span>Our Services</span></h6>
        <h2 class="section-caption__title glitch-text" data-text="720° PROTECTION">720&deg; PROTECTION</h2>
        <p class="section-caption__desc">Nothing for the Network. Nothing at the Endpoint.</p>
