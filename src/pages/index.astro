        <a href="#link-pricing" class="product-card product-card--featured">
          <div class="product-card__inner product-card__inner--accent">
            <div class="product-card__image">
              <img src="/images/home-01-card-2.png" alt="Nothing Data Loss Prevention" />
            </div>
