---
interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  showButton?: boolean;
  buttonText?: string;
  buttonHref?: string;
}

const { title, subtitle, backgroundImage, showButton, buttonText, buttonHref } = Astro.props;
---

<section class="page-header">
  {backgroundImage && <img src={backgroundImage} alt="" class="page-header__bg" data-parallax data-parallax-ratio="0.1" />}
  <div class="page-header__overlay"></div>
  <div class="page-header__content container">
    <i class="page-header__decor"></i>
    <h1 class="page-header__title glitch-text" data-text={title}>{title}</h1>
    {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
    {showButton && buttonText && (
      <div style="margin-top: 2rem;">
        <a href={buttonHref || "#"} class="btn btn--primary btn--large">{buttonText}</a>
      </div>
    )}
  </div>
</section>
