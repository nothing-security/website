<style>
  /* === Hero === */
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: visible;
    background: #0a0a1a url('/images/header-home01-header.jpg') center top / cover no-repeat fixed;
  }
  .hero__bg {
    display: none;
  }
  .hero__overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(
      135deg,
      rgba(10, 2, 50, 0.55) 0%,
      rgba(95, 0, 144, 0.25) 40%,
      rgba(20, 103, 171, 0.15) 70%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 1;
  }
  .hero__particles {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  .hero__particles hr {
    position: absolute;
    border: none;
    margin: 0;
    padding: 0;
    background: linear-gradient(45deg, var(--color-gradient-start), var(--color-gradient-end));
    opacity: 0.6;
    animation: particle-float 2.5s ease-in-out infinite, particle-flicker 1.8s steps(2) infinite;
  }
  .hero__particles hr:nth-child(2n) {
    animation-delay: -0.7s, -0.3s;
    opacity: 0.4;
  }
  .hero__particles hr:nth-child(3n) {
    animation-delay: -1.2s, -0.9s;
    opacity: 0.8;
  }
  .hero__particles hr:nth-child(4n) {
    animation-delay: -0.4s, -1.5s;
    opacity: 0.5;
  }
  @keyframes particle-float {
    0%, 100% { transform: translateY(0) translateX(0); }
    25% { transform: translateY(-8px) translateX(3px); }
    50% { transform: translateY(-14px) translateX(-2px); }
    75% { transform: translateY(-6px) translateX(4px); }
  }
  @keyframes particle-flicker {
    0%, 49% { opacity: inherit; }
    50%, 100% { opacity: 0.15; }
  }
  .hero__content {
    position: relative;
    z-index: 3;
    padding: 100px 20px 100px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .hero__decor {
    display: block;
    width: 50px;
    height: 4px;
    background: linear-gradient(45deg, var(--color-gradient-start), var(--color-gradient-end));
    margin-bottom: 24px;
  }
  .hero__title {
    font-family: var(--font-heading);
    font-size: 4.2rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 24px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .hero__subtitle {
